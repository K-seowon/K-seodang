rules_version = '2';

// 운교서당 Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여 넣고 「게시」한다.
// 이 파일은 공개돼도 괜찮다(규칙은 숨겨서 지키는 것이 아니다).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // 내 기록 users/{uid} — 나만 읽고 쓴다.
    // { data: 기록 전체(JSON 문자열), updatedAt: 저장한 때(밀리초), v: 형식 버전 }
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.updatedAt is number;
    }

    // 공개 정원 gardens/{uid} — 로그인한 사람은 누구나 읽고, 쓰기는 주인만.
    // 배열·맵 안의 값 하나하나는 규칙으로 다 검사할 수 없으므로, 앱이 남의
    // 정원을 화면에 그리기 전에 반드시 거른다(index.html의 sanitizeGarden).
    match /gardens/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGarden(request.resource.data);

      // 이웃이 물을 준 기록 — 다른 사람이 남기고, 주인만 읽고 지운다
      match /visits/{vid} {
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['fromUid', 'from', 'iid', 'at'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.from is string && request.resource.data.from.size() <= 8
          && request.resource.data.iid is string && request.resource.data.iid.size() <= 40
          && request.resource.data.at == request.time;
        allow read, delete: if isOwner(uid);
      }
    }

    function validGarden(d) {
      return d.keys().hasOnly(['nick', 'rankIdx', 'chars', 'placed', 'spot', 'growth', 'likes', 'wear', 'updatedAt'])
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 8
        && d.rankIdx is int && d.rankIdx >= 0 && d.rankIdx <= 5
        && d.chars is int && d.chars >= 0 && d.chars <= 1000
        && d.placed is list && d.placed.size() <= 200
        && d.spot is map && d.spot.size() <= 200
        && d.growth is map && d.growth.size() <= 200
        && d.likes is map && d.likes.size() <= 200
        && d.wear is map
        && d.updatedAt == request.time;
    }

    // 그 밖의 곳은 모두 막힌다
  }
}
